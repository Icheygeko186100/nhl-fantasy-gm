<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Away Team: Badge & Abbrev -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_away_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Away Team"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_away_abbrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0" />
    </LinearLayout>

    <!-- Away Score -->
    <TextView
        android:id="@+id/tv_away_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <!-- Center: Status Pill & Subtext -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tv_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_status_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="10sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Home Score -->
    <TextView
        android:id="@+id/tv_home_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <!-- Home Team: Badge & Abbrev -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_home_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Home Team"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_home_abbrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0" />
    </LinearLayout>

</LinearLayout>
